{
    "name": "ORB-SLAM3 C++",
    "image": "orbslam3:dev",
    "shutdownAction": "stopContainer",
    // Component ID for the C++ container features
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {}
    },
    // Add Extensions
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake"
            ],
            "settings": {
                "cmake.configureOnOpen": true
            }
        }
    },
    // Use 'vscode' user from the base image
    "remoteUser": "vscode"
}
